<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/titulo"
            style="@style/AmareloTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="34sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/app_tagline"
            android:textColor="@color/tinta_fraca"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo" />

        <LinearLayout
            android:id="@+id/pill_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitulo">

            <View
                android:id="@+id/ponto_status"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/tinta_fraca" />

            <TextView
                android:id="@+id/txt_status"
                style="@style/AmareloRotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/status_idle" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_toggle"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_botao"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pill_status">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ic_toggle"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/start"
                    android:src="@drawable/ic_bolha_play" />

                <TextView
                    android:id="@+id/txt_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.12"
                    android:text="@string/start"
                    android:textColor="@color/amarelo"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/card_endereco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_toggle">

            <TextView
                style="@style/AmareloRotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_open_on_tv"
                android:textColor="#B3A98C" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/amarelo"
                    android:textIsSelectable="true"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="http://192.168.0.14:8080" />

                <ImageButton
                    android:id="@+id/btn_copiar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_copy"
                    android:src="@drawable/ic_copy" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_aviso_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/msg_need_wifi"
                android:textColor="#B3A98C"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_como_conectar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/msg_how_to_connect"
                android:textColor="#D8D2C4"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_qualidade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_endereco">

            <TextView
                style="@style/AmareloRotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_quality"
                android:textColor="#B3A98C" />

            <TextView
                style="@style/AmareloRotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/label_resolution"
                android:textColor="#B3A98C" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupo_resolucao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_480"
                    style="@style/AmareloChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="480p" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_720"
                    style="@style/AmareloChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="720p" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_1080"
                    style="@style/AmareloChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1080p" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/rotulo_fps"
                style="@style/AmareloRotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#B3A98C" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_fps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="15"
                android:valueFrom="5"
                android:valueTo="30"
                app:labelBehavior="gone"
                app:thumbColor="@color/amarelo"
                app:tickVisible="false"
                app:trackColorActive="@color/amarelo"
                app:trackColorInactive="#4DFFFFFF" />

            <TextView
                android:id="@+id/rotulo_jpeg"
                style="@style/AmareloRotulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#B3A98C" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_jpeg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:value="70"
                android:valueFrom="30"
                android:valueTo="95"
                app:labelBehavior="gone"
                app:thumbColor="@color/amarelo"
                app:tickVisible="false"
                app:trackColorActive="@color/amarelo"
                app:trackColorInactive="#4DFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_qualidade">

            <TextView
                style="@style/AmareloRotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_stats"
                android:textColor="#B3A98C" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmareloRotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_fps"
                        android:textColor="#B3A98C" />

                    <TextView
                        android:id="@+id/valor_fps"
                        style="@style/AmareloValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmareloRotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_bitrate"
                        android:textColor="#B3A98C" />

                    <TextView
                        android:id="@+id/valor_bitrate"
                        style="@style/AmareloValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmareloRotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_clients"
                        android:textColor="#B3A98C" />

                    <TextView
                        android:id="@+id/valor_clientes"
                        style="@style/AmareloValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmareloRotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_resolution"
                        android:textColor="#B3A98C" />

                    <TextView
                        android:id="@+id/valor_resolucao"
                        style="@style/AmareloValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_log"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_stats">

            <TextView
                style="@style/AmareloRotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_log"
                android:textColor="#B3A98C" />

            <TextView
                android:id="@+id/txt_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="#D8D2C4"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
